# Adamantite — environment variables.
# Copy this file to .env.local and fill in real values for local development.
# Parsed once, at process start, by lib/server/env.ts — nothing else in the codebase
# reads process.env directly.

# Required. Signs and verifies the `ada_session` cookie (HMAC). Use a long random string
# (e.g. `openssl rand -hex 32`). There is no default — the process refuses to start without it.
AUTH_SECRET=dev-only-change-me-00000000000000000000000000000000

# Required for user accounts in production. Neon Postgres connection string. The `ada_accounts`
# table is created automatically on first use, so no migration step is needed.
#
# Leave it unset locally and accounts fall back to a JSON file under `.data/accounts.json`.
# That fallback CANNOT work on Vercel: the filesystem there is read-only apart from a
# per-invocation `/tmp`, so an account created by one request is gone by the next. Set this
# before anyone signs up on the deployed site.
# DATABASE_URL=postgresql://user:password@ep-...neon.tech/neondb?sslmode=require

# Optional. Set to 1 if your Postgres provider presents a certificate Node's default CA bundle
# rejects (some self-hosted and Supabase pooler setups).
# DATABASE_SSL_NO_VERIFY=1

# Optional. Overrides the JSON-file fallback data directory. Defaults to
# `E:\Adamantite\Database`, outside OneDrive, to avoid sync/file-lock churn.
# ADAMANTITE_DATA_DIR=E:\Adamantite\Database

# Optional. The single shared upstream model-provider API key. Unset in M1 — the mock adapter
# does not require it and reports a MOCK sentinel through the same accessor a real adapter uses.
# ADAMANTITE_PROVIDER_API_KEY=

# Required for real Stripe checkout on /pricing. Use your Stripe secret key from Dashboard.
# STRIPE_SECRET_KEY=sk_live_...

# Required for webhook verification at /api/stripe/webhook.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Required for the 50/50 split transfer after checkout.session.completed.
# These must be Stripe Connect account IDs.
# OWNER_STRIPE_CONNECTED_ACCOUNT_ID=acct_...
# PROVIDER_STRIPE_CONNECTED_ACCOUNT_ID=acct_...

# Optional. Canonical production URL used for Stripe success/cancel redirects.
# Vercel can infer from VERCEL_URL, but setting SITE_URL is cleaner.
# SITE_URL=https://your-domain.com

# Optional. Multiplies every mock generation's queued/running duration. Default: 1.
# Set to 0 in tests so generations resolve instantly.
# MOCK_LATENCY_SCALE=1

# Optional. Probability (0..1) that a mock generation is deterministically failed
# (in addition to the `/\bfail\b/i` prompt trigger). Default: 0.
# MOCK_FAILURE_RATE=0
