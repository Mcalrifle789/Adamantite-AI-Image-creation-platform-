# Adamantite — environment variables.
# Copy this file to .env.local and fill in real values for local development.
# Parsed once, at process start, by lib/server/env.ts — nothing else in the codebase
# reads process.env directly.

# Required. Signs and verifies the `ada_session` cookie (HMAC). Use a long random string
# (e.g. `openssl rand -hex 32`). There is no default — the process refuses to start without it.
AUTH_SECRET=dev-only-change-me-00000000000000000000000000000000

# Optional. Overrides the JSON-file data directory (defaults to `.data` at the project root,
# applied by lib/server/db — out of scope for this task). Useful on OneDrive-synced machines to
# point the store at a non-synced path and avoid file-lock churn.
# ADAMANTITE_DATA_DIR=

# Optional. The single shared upstream model-provider API key. Unset in M1 — the mock adapter
# does not require it and reports a MOCK sentinel through the same accessor a real adapter uses.
# ADAMANTITE_PROVIDER_API_KEY=

# Optional. Multiplies every mock generation's queued/running duration. Default: 1.
# Set to 0 in tests so generations resolve instantly.
# MOCK_LATENCY_SCALE=1

# Optional. Probability (0..1) that a mock generation is deterministically failed
# (in addition to the `/\bfail\b/i` prompt trigger). Default: 0.
# MOCK_FAILURE_RATE=0
