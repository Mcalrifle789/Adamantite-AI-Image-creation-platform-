# Nine-agent squad workspace (coordination state, not application code)
.agents/
.claude/agent-memory/

# Runtime JSON persistence (ADR-01) — generated, per-machine, never committed.
# The real Windows default is E:\Adamantite\Database (outside the repo); these repo-local paths
# are kept for anyone whose ADAMANTITE_DATA_DIR points here. The local account store writes
# password hashes into accounts.json, so local fallback directories must not be missed.
.data/
data/

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# Env files
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
